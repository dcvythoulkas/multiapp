#!/usr/bin/env bash
#
# gandi-ddns.sh
#
# Dynamic DNS updater for Gandi LiveDNS
#

set -euo pipefail

#############################
# Configuration
#############################

DOMAIN="{{ gandi_domain }}"
HOST="{{ gandi_host }}"              # Use "@" for the root domain
TTL=300

TOKEN_FILE="{{ gandi_conf }}"
LOGFILE="/var/log/gandi-ddns.log"

#############################

[[ -f "$TOKEN_FILE" ]] || {
    echo "Missing $TOKEN_FILE"
    exit 1
}

source "$TOKEN_FILE"

API="https://api.gandi.net/v5/livedns/domains/${DOMAIN}/records/${HOST}/A"

log() {
    echo "$(date '+%F %T') $*" >> "$LOGFILE"
}

curl_retry() {
    curl \
        --silent \
        --show-error \
        --fail \
        --retry 5 \
        --retry-delay 5 \
        --connect-timeout 10 \
        "$@"
}

#
# Get current WAN IP
#
PUBLIC_IP=$(curl_retry https://api.ipify.org)

if ! [[ "$PUBLIC_IP" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then
    log "ERROR Invalid IP: $PUBLIC_IP"
    exit 1
fi

#
# Read current DNS record
#
DNS_IP=$(
curl_retry \
    -H "Authorization: Bearer ${GANDI_PAT}" \
    "$API" |
jq -r '.rrset_values[0]'
)

#
# Nothing changed?
#
if [[ "$PUBLIC_IP" == "$DNS_IP" ]]; then
    exit 0
fi

log "IP changed ${DNS_IP} -> ${PUBLIC_IP}"

#
# Update record
#
JSON=$(jq -n \
    --arg ip "$PUBLIC_IP" \
    --argjson ttl "$TTL" \
'{
    rrset_values: [$ip],
    rrset_ttl: $ttl
}')

curl_retry \
    -X PUT \
    -H "Authorization: Bearer ${GANDI_PAT}" \
    -H "Content-Type: application/json" \
    --data "$JSON" \
    "$API" >/dev/null

log "Gandi record updated successfully"
