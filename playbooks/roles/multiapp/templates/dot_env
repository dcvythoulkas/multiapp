# Environmental variables for all apps

## Nextcloud vars ##
{% if docker.applications.nextcloud.database == 'postgresql' }}
# Database vars - PostgreSQL
nc_pgdb_host: nc_pgdb
nc_pgdb_db: {{ docker.nextcloud.applications.env.nc_pgdb }}
nc_pgdb_user: {{ docker.nextcloud.applications.env.ng_pgdb_user }}
nc_pgdb_password: {{ docker.nextcloud.applications.env.nc_pgdb_password }}
{% else %}
# Database vars - MariaDB
nc_mardb_host: nc_mardb
nc_mardb_root_password: {{ docker.nextcloud.applications.env.nc_mardb_root_password }}
nc_mardb_db: {{ docker.nextcloud.applications.env.nc_mardb_db }}
nc_mardb_user_name: {{ docker.nextcloud.applications.env.nc_mardb_user_name }}
nc_mardb_user_pass: {{ docker.nextcloud.applications.env.nc_mardb_user_pass }}
{% endif %}
# Application vars
nc_trusted_domains: "{{ docker.nextcloud.applications.env.nc_trusted_domains }}"
nc_admin_user: {{ docker.nextcloud.applications.env.nc_admin_user }}
nc_admin_password: "{{ docker.nextcloud.applications.env.nc_admin_password }}"

# SMTP vars - GOOGLE
smtp_host: "smtp.gmail.com"
smtp_encryption: tls
smtp_port: 587
smtp_authtype: login
smtp_username: "{{ docker.nextcloud.applications.env.smtp_username }}"
smtp_password: "{{ docker.nextcloud.applications.env.smtp_password }}"
smtp_from_address: "{{ docker.nextcloud.applications.env.smtp_from_address }}"
smtp_from_domain: "gmail.com"

