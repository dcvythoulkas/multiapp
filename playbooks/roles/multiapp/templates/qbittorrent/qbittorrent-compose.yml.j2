---
services:
  bittorrent-client:
    image: lscr.io/linuxserver/qbittorrent:{{ docker.applications.qbittorrent.version }}
    container_name: qbittorrent
    restart: unless-stopped
    environment:
      - PUID={{ docker.uid }}
      - PGID={{ docker.gid }}
      - TZ=Europe/Athens
      - WEBUI_PORT=8080
      - TORRENTING_PORT=6881
    networks:
      webproxy-backend:
        ipv4_address: "10.254.0.14"
    volumes:
      - ./appdata:/config
      - ../streaming-media:/streaming-media
    ports:
#      - 8080:8080
      - 6881:6881
      - 6881:6881/udp
