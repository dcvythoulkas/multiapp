include:
{% if docker.applications.nextcloud.version is defined %}  - ./nextcloud/nextcloud-compose.yml{% endif %}

{% if docker.applications.jellyfin.version is defined %}  - ./jellyfin/jellyfin-compose.yml{% endif %}

{% if docker.applications.qbittorrent.version is defined %}  - ./qbittorrent/qbittorrent-compose.yml{% endif %}

{% if docker.applications.pihole.version is defined %}  - ./pihole/pihole-compose.yml{% endif %}

{% if docker.applications.prowlarr.version is defined %}  - ./prowlarr/prowlarr-compose.yml{% endif %}

{% if docker.applications.flaresolverr.version is defined %}  - ./flaresolverr/flaresolverr-compose.yml{% endif %}

{% if docker.applications.radarr.version is defined %}  - ./radarr/radarr-compose.yml{% endif %}

{% if docker.applications.vaultwarden.version is defined %}  - ./vaultwarden/vaultwarden-compose.yml{% endif %}


networks:
  webproxy-backend:
    ipam:
      config:
        - subnet: 10.254.0.0/16

services:

  webproxy:
    image: traefik:v{{ docker.applications.traefik.version }}
    container_name: webproxy
    restart: unless-stopped
    security_opt:
      - no-new-privileges:true
    volumes:
      - /etc/localtime:/etc/localtime:ro
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - ./traefik/install/traefik.yml:/etc/traefik/traefik.yml:ro
      - ./traefik/install/acme.json:/etc/traefik/acme.json
      - ./traefik/routing:/etc/traefik/routing:ro
      - ./traefik/logs:/var/log/traefik
    ports:
      - "80:80"
      - "81:81"
      - "443:443"
      - "444:444"
      - "8088:8080"
    networks:
      webproxy-backend:
        ipv4_address: "10.254.254.254"
    environment:
      - GANDIV5_PERSONAL_ACCESS_TOKEN=${GANDIV5_PERSONAL_ACCESS_TOKEN}
    labels:
      - traefik.enable=true
      - traefik.http.routers.traefik_https.rule=Host(`{{ docker.applications.traefik.gandi_host }}.{{ gandi_domain }}`)
      - traefik.http.routers.traefik_https.entrypoints=websecure-int
      - traefik.http.routers.traefik_https.tls=true
      - traefik.http.routers.traefik_https.tls.certresolver={{ docker.applications.traefik.acme_certs }}
      - traefik.http.routers.traefik.tls.domains[0].main={{ gandi_subdomain.replace(".","") }}.{{ gandi_domain }}
      - traefik.http.routers.traefik.tls.domains[0].sans=*{{ gandi_subdomain.replace(".","") }}.{{ gandi_domain }}
      - traefik.http.routers.traefik_https.service=api@internal
