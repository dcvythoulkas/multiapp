---
services:
  stream-server:
    image: jellyfin/jellyfin:{{ docker.applications.jellyfin.version }}
    container_name: jellyfin
    restart: 'unless-stopped'
    user: {{ docker.uid }}:{{ docker.gid }}
    networks:
      webproxy-backend:
        ipv4_address: "10.254.0.11"
    volumes:
      - ./config:/config
      - ./cache:/cache
      - ../streaming-media:/media
